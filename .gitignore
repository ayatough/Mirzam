/target
/out
/site
# No trailing slash: `playwright-core` is not a dependency here, so the
# screenshot and layout scripts get it linked in from outside the repo, and a
# symlink is not a directory as far as a trailing slash is concerned.
node_modules
*.log
pkg/
*.vsix
# The demo recordings. The GIF beside them is committed, because the README has
# to show it and GitHub renders a repository file; the webm it was made from is
# the intermediate, and a lossless copy of the same twenty seconds is not worth
# a megabyte and a half in every clone.
media/*.webm
media/*.mp4

# Python leaves these behind when a script here is imported rather than run.
__pycache__/
*.pyc
