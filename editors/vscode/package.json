{
  "name": "mirzam-preview",
  "displayName": "Mirzam Preview",
  "description": "Live preview for Mirzam, a Markdown-based slide tool, running the Rust core as WebAssembly",
  "version": "0.10.0",
  "publisher": "mirzam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayatough/Mirzam"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Visualization", "Other"],
  "keywords": ["markdown", "slides", "presentation", "mirzam"],
  "activationEvents": ["onLanguage:markdown"],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mirzam.showPreview",
        "title": "Mirzam: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "mirzam.exportHtml",
        "title": "Mirzam: Export as HTML"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mirzam.showPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mirzam.showPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Mirzam",
      "properties": {
        "mirzam.previewDelay": {
          "type": "number",
          "default": 120,
          "description": "Delay in milliseconds between an edit and the preview update"
        },
        "mirzam.maxAssetSize": {
          "type": "number",
          "default": 20971520,
          "description": "Maximum size in bytes of images and video inlined into the preview"
        },
        "mirzam.languageServer": {
          "type": "boolean",
          "default": true,
          "description": "Run `mirzam lsp` for diagnostics, completion, hover and go-to-definition in decks. Needs the mirzam CLI on PATH (or mirzam.serverPath); the preview works without it."
        },
        "mirzam.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the mirzam binary the language server runs from. Empty means `mirzam` on PATH."
        }
      }
    }
  }
}
